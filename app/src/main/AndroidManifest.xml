<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The Wi-Fi signal, for the MQTT state report -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Offering apps to install (Apps tab of the settings). The user still
         confirms every install in the system's own screen. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Uninstalling from the app list's long-press menu. Without it the
         system's uninstall dialog opens and closes again in the same instant,
         logging "does not have android.permission.REQUEST_DELETE_PACKAGES", so
         the menu item looks like it does nothing. The user still confirms in
         that dialog. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Keeps the screen on while an install is in progress -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Reads the Bluetooth name, which is the name the user gave the device
         and so its MQTT topic prefix. Granted at install up to Android 11;
         later versions need BLUETOOTH_CONNECT at runtime, and MqttSettings
         reads the setting behind it instead. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- Switches high contrast text (TextContrast). Only adb can grant it
         (tools/setup-device.sh); without the grant the System tab's switch
         does nothing. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- The home button drawn over apps that hide the Portal's own Back/Home
         bar (WhatsApp does). The user grants it in the System tab and picks the
         apps in the app list's long-press menu. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Needed from Android 14 for the "specialUse" service below -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Calls between Portals (call/CallActivity.kt). The camera and the
         microphone are only granted on a device that takes part in calls
         (System tab, or tools/push-config.sh). MODIFY_AUDIO_SETTINGS puts the
         audio in call mode for the length of a call. WebRTC watches the
         network, and without ACCESS_NETWORK_STATE its native code aborts the
         process as the call starts. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Lets AppListActivity see the apps it can launch (Android 11+ hides
         other packages otherwise) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: Immich servers on a home network are often plain http -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AstroDock"
        android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute">

        <!-- The home screen. singleTask + stateNotNeeded is what a launcher
             wants: pressing Home returns to this one activity, closing
             anything opened on top of it, and it survives being killed. -->
        <activity
            android:name=".SlideshowActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.AstroDock.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Makes it selectable as the home screen. It only becomes the
                 home screen once the user picks it (System settings tab). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- It draws an overlay for as long as another app is in front, which
             is none of the standard service types -->
        <service
            android:name=".overlay.HomeButtonService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- The slideshow as the system screensaver. BIND_DREAM_SERVICE means
             only the system can start it. -->
        <service
            android:name=".SlideshowDreamService"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream" />
        </service>

        <activity
            android:name=".AppListActivity"
            android:exported="false"
            android:theme="@style/Theme.AstroDock.Fullscreen" />

        <!-- Lets the system installer read the APKs we download -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.apks"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Holds the notification access permission, which is what lets the
             slideshow read and control what other apps are playing. Only the
             system can bind it. -->
        <service
            android:name=".media.MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Turns the screen off; activated by the user in the system settings tab -->
        <receiver
            android:name=".ScreenAdminReceiver"
            android:description="@string/system_admin_explanation"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Goes back to the home screen after an update, which otherwise
             can leave the Portal's own one in front (UpdateReceiver) -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- A call, in a process of its own: Android takes the default home
             app away from one whose process crashes, and WebRTC is a lot of
             native code. A task of its own too, so it doesn't bring the app
             list back with it. -->
        <activity
            android:name=".call.CallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":call"
            android:taskAffinity="${applicationId}.call"
            android:theme="@style/Theme.AstroDock.Fullscreen" />

        <!-- The main process's end of a call, which CallActivity binds to -->
        <service
            android:name=".call.CallSignalService"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".SlideshowActivity" />

        <!-- Takes the shortcuts other apps pin to the home screen, such as a
             page Firefox adds. Exported because the system starts it; a request
             that didn't come from the system is ignored. Invisible, and gone
             as soon as it has accepted the request. -->
        <activity
            android:name=".PinShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
