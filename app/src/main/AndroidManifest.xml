<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Offering apps to install (Apps tab of the settings). The user still
         confirms every install in the system's own screen. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Keeps the screen on while an install is in progress -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Sets how long the Portal waits before starting the screensaver. It only
         works once the user allows it in the System tab: Settings.System.canWrite()
         needs both this declaration and that grant. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Sets sleep_timeout: how long after the Portal last saw someone the
         screen goes off. Only adb can grant it (tools/setup-device.sh); without
         the grant the app carries on with the Portal's own delay. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- The home button drawn over apps that hide the Portal's own Back/Home
         bar (WhatsApp does). The user grants it in the System tab and picks the
         apps in the app list's long-press menu. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Needed from Android 14 for the "specialUse" service below -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Lets AppListActivity see the apps it can launch (Android 11+ hides
         other packages otherwise) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: Immich servers on a home network are often plain http -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AstroDock"
        android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute">

        <!-- The home screen. singleTask + stateNotNeeded is what a launcher
             wants: pressing Home returns to this one activity, closing
             anything opened on top of it, and it survives being killed. -->
        <activity
            android:name=".SlideshowActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.AstroDock.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Makes it selectable as the home screen. It only becomes the
                 home screen once the user picks it (System settings tab). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- It draws an overlay for as long as another app is in front, which
             is none of the standard service types -->
        <service
            android:name=".overlay.HomeButtonService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- The slideshow as the system screensaver. BIND_DREAM_SERVICE means
             only the system can start it. -->
        <service
            android:name=".SlideshowDreamService"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream" />
        </service>

        <activity
            android:name=".AppListActivity"
            android:exported="false"
            android:theme="@style/Theme.AstroDock.Fullscreen" />

        <!-- Lets the system installer read the APKs we download -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.apks"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Holds the notification access permission, which is what lets the
             slideshow read and control what other apps are playing. Only the
             system can bind it. -->
        <service
            android:name=".media.MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Turns the screen off; activated by the user in the system settings tab -->
        <receiver
            android:name=".ScreenAdminReceiver"
            android:description="@string/system_admin_explanation"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".SlideshowActivity" />
    </application>

</manifest>
