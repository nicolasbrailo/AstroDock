<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AstroDock" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Slideshow: no action bar, black behind the pictures -->
    <style name="Theme.AstroDock.Fullscreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <!-- The window is created full screen, rather than hiding the bars once
             it is already on screen: the system clears those flags whenever a
             window loses focus, so the Portal's status bar used to flash in
             (and resize the picture) every time the screensaver handed over. -->
        <item name="android:windowFullscreen">true</item>
        <!-- No open or close animation. The screensaver and the home screen show
             the same picture, so the swap between them should be invisible. -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Dark dialogs, so the white app labels in a folder stay readable -->
    <style name="Theme.AstroDock.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:background">#FF202020</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">#FFCCCCCC</item>
    </style>
</resources>