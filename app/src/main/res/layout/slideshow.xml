<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- No keepScreenOn: the Portal turns the screen off when nobody is around
         (see the Portal notes in AGENTS.md) -->

    <!-- The picture on screen and its neighbours, which SlideshowActivity keeps
         off screen to either side and slides in while swiping. Which view plays
         which role changes as the user moves through pictures. -->
    <ImageView
        android:id="@+id/picture_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/picture_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/picture_c"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <!-- Bottom left corner: the time, and the metadata of the picture on screen.
         Shadows keep the text readable over bright pictures. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:orientation="vertical">

        <!-- Current temperature and an icon for the sky, refreshed on the
             hour. Hidden unless the Slideshow tab turns it on. -->
        <LinearLayout
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/weather_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/weather_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:shadowColor="#CC000000"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:textColor="@android:color/white"
                android:textSize="30sp" />
        </LinearLayout>

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:shadowColor="#CC000000"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="@android:color/white"
            android:textSize="56sp" />

        <!-- Tapping toggles between one line and the full details -->
        <TextView
            android:id="@+id/picture_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            android:maxWidth="600dp"
            android:paddingVertical="4dp"
            android:paddingHorizontal="4dp"
            android:shadowColor="#CC000000"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- What the Portal is doing; shown by tapping the clock -->
    <TextView
        android:id="@+id/debug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="@drawable/status_background"
        android:fontFamily="monospace"
        android:padding="12dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- What another app is playing, with controls. Hidden when nothing is. -->
    <LinearLayout
        android:id="@+id/now_playing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/status_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/now_playing_art"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/now_playing_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="280dp"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/now_playing_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="280dp"
                android:textColor="#FFCCCCCC"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/now_playing_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/media_previous"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/now_playing_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/media_play_pause"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/now_playing_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/media_next"
            android:src="@drawable/ic_skip_next" />
    </LinearLayout>

    <!-- A message sent over MQTT (cmd/ambience/announce) -->
    <TextView
        android:id="@+id/announcement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:background="@drawable/status_background"
        android:gravity="center"
        android:maxWidth="900dp"
        android:padding="24dp"
        android:textColor="@android:color/white"
        android:textSize="34sp"
        android:visibility="gone" />

    <!-- Something is wrong that the pictures don't show by themselves: the MQTT
         broker can't be reached. Only the home screen puts it up; the
         screensaver runs all night and shouldn't nag. -->
    <TextView
        android:id="@+id/alert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/status_background"
        android:maxWidth="560dp"
        android:padding="12dp"
        android:textColor="#FFFFC107"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Shown while loading or when something failed -->
    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:background="@drawable/status_background"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
